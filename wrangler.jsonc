{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softtaskglobalwebsite",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
  "vars": {
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAE2KzH37PqwhUbvB",
    "SITE_ORIGIN": "https://softtask.co",
    "ADDITIONAL_SITE_ORIGINS": "https://www.softtask.co,https://softtaskglobalwebsite.softtask-tech.workers.dev",
    "MAIL_FROM": "Soft Task Website <notifications@softtask.co>",
    "MAIL_REPLY_TO": "contact@softtask.co",
    "NOTIFY_TO": "contact@softtask.co"
  },
  "triggers": { "crons": ["0 3 * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "softtask-newsletter",
    "database_id": "3f03e4ae-24a3-4804-987e-0166f246a8f6",
    "migrations_dir": "worker/migrations"
  }],
}
