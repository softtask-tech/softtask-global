{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softtask-global",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
  },
  "vars": { "SITE_ORIGIN": "https://softtask.co" },
  "triggers": { "crons": ["0 3 * * *"] },
}
