{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softtask-global",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
  },
  "vars": {
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAE2KzH37PqwhUbvB",
    "SITE_ORIGIN": "https://softtask.co",
    "MAIL_FROM": "Soft Task Website <notifications@softtask.co>",
    "MAIL_REPLY_TO": "contact@softtask.co",
    "NOTIFY_TO": "contact@softtask.co"
  },
  "triggers": { "crons": ["0 3 * * *"] },
}
