---
import { presence } from '../data/presence';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section
  class:list={['presence-section', compact && 'presence-compact']}
  aria-labelledby="presence-title"
>
  <div class="wrap presence-intro">
    <div>
      <p>Our presence</p>
      <h2 id="presence-title">
        Headquartered in Singapore.
        <br />
        Connected across borders.
      </h2>
    </div>
    <div class="reach-stat">
      <strong>33+</strong>
      <span>countries served</span>
      <p>
        Client reach across markets. Each engagement brings its own business and operating context.
      </p>
    </div>
  </div>
  <div class="wrap presence-explorer" data-presence>
    <div class="presence-network">
      <svg viewBox="0 0 800 420" aria-hidden="true" class="connection-lines" data-draw>
        <ellipse cx="410" cy="210" rx="300" ry="165" />
        <ellipse cx="410" cy="210" rx="180" ry="165" />
        <path d="M110 210H710M170 110H650M170 310H650" />
        {presence
          .filter((p) => p.id !== 'singapore')
          .map((p) => (
            <path class="route-line" d={`M584 273 Q${p.x * 8} 100 ${p.x * 8} ${p.y * 4.2}`} />
          ))}
      </svg>
      <div class="presence-pins">
        {presence.map((p, i) => (
          <button
            style={`--x:${p.x}%;--y:${p.y}%`}
            class:list={['presence-pin', i === 0 && 'is-selected']}
            data-presence-target={p.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
            aria-controls={`presence-${p.id}`}
          >
            <span></span>
            {p.name}
          </button>
        ))}
      </div>
      <span class="network-caption">Regional connections · schematic, not a geographic map</span>
    </div>
    <div class="presence-readout">
      {presence.map((p, i) => (
        <article id={`presence-${p.id}`} data-presence-panel={p.id} hidden={i !== 0}>
          <p class="presence-role">{p.role}</p>
          <h3>{p.city}</h3>
          <p>{p.note}</p>
          {p.address && <address>{p.address}</address>}
          <a class="text-link" href={compact ? '/company/locations/' : p.url}>
            {compact
              ? 'Explore our presence'
              : p.url.startsWith('http')
                ? 'Visit country website'
                : 'Discuss a project'}{' '}
            <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
