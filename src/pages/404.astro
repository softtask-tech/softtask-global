---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Page not found" description="This page could not be found. Explore Soft Task enterprise technology capabilities, products and company information, or return to the homepage.">
  <section class="page-hero compact-page">
    <div class="wrap">
      <div class="breadcrumb">
        <span>404 / Page not found</span>
      </div>
      <h1>
        Let’s find
        <br />
        <em>a better direction.</em>
      </h1>
      <p class="lead">This page is not here. Explore our capabilities or return to the homepage.</p>
      <div class="content-actions">
        <a class="button primary" href="/">
          Back to Soft Task <Icon />
        </a>
        <a class="button" href="/services/">
          Explore capabilities <Icon />
        </a>
      </div>
    </div>
  </section>
</Layout>
