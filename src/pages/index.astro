---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import ContactBand from '../components/ContactBand.astro';
import { services, products } from '../data/services';
import { articles } from '../data/articles';
---

<Layout title="Enterprise technology, thoughtfully engineered" dark>
  <section class="home-hero">
    <div class="hero-copy">
      <p class="hero-intro">Software. Intelligence. Infrastructure.</p>
      <h1>
        Big ambitions.
        <br />
        <em>Solid foundations.</em>
      </h1>
      <p class="hero-description">
        Build the applications your teams need. Connect the data they depend on. Plan the
        infrastructure behind it. Soft Task brings those decisions together, from the first
        requirement to handover.
      </p>
      <a class="button light" href="/services/">
        Explore our capabilities <Icon />
      </a>
      <div class="hero-footnote">
        <span class="status-dot"></span>Technology for innovators.
      </div>
    </div>
    <div class="hero-photo">
      <Photo name="team" alt="Engineer photographed with projected software code" eager />
      <div class="photo-caption">
        <span>
          Human ideas.
          <br />
          Real-world systems.
        </span>
        <span class="photo-credit">Illustrative photography</span>
      </div>
    </div>
    <a class="hero-scroll" href="#capabilities" aria-label="Explore capabilities">
      <span>Explore</span>
      <Icon />
    </a>
  </section>
  <div class="discipline-strip">
    <div class="wrap">
      <p>Built around your business.</p>
      <span>Software engineering</span>
      <span>AI & data</span>
      <span>Cloud & infrastructure</span>
      <a href="/company/">
        Meet Soft Task <Icon name="diagonal" size={17} />
      </a>
    </div>
  </div>
  <section class="section wrap opening">
    <h2>
      Progress happens
      <br />
      when things <em>connect.</em>
    </h2>
    <div>
      <p class="lead">
        An application is only as useful as the systems around it. An AI idea is only as strong as
        the data behind it.
      </p>
      <p>
        We look at those connections. From the software your teams use to the infrastructure it runs
        on, we help turn a technology requirement into a practical way forward.
      </p>
      <a class="text-link" href="/company/how-we-work/">
        How we approach the work <Icon />
      </a>
    </div>
  </section>
  <section class="capability-section" id="capabilities">
    <div class="wrap">
      <div class="section-heading">
        <h2>
          What do you want
          <br />
          to move forward?
        </h2>
        <a class="text-link" href="/services/">
          All capabilities <Icon />
        </a>
      </div>
      <div class="capability-explorer">
        <div
          class="capability-tabs"
          role="tablist"
          aria-label="Explore capabilities"
          aria-orientation="vertical"
        >
          {services.map((s, i) => (
            <button
              id={`tab-${i}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${i}`}
              tabindex={i === 0 ? 0 : -1}
              data-tab={i}
            >
              <span>{s.name}</span>
              <Icon name="diagonal" />
            </button>
          ))}
        </div>
        <div class="capability-panels">
          {services.map((s, i) => (
            <section
              id={`panel-${i}`}
              role="tabpanel"
              aria-labelledby={`tab-${i}`}
              hidden={i !== 0}
              tabindex="0"
            >
              <Photo name={s.image} alt={s.alt} />
              <div class="capability-detail">
                {s.image === 'facility' && (
                  <p class="image-disclosure">AI-generated infrastructure illustration</p>
                )}
                <h3>{s.short}</h3>
                <p>{s.intro}</p>
                <a class="text-link" href={`/services/${s.slug}/`}>
                  Explore {s.name.toLowerCase()} <Icon />
                </a>
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section class="section wrap approach">
    <div class="section-heading">
      <h2>Clarity before complexity.</h2>
      <p>A good project starts with the right questions.</p>
    </div>
    <div class="approach-steps">
      {[
        {
          n: '01',
          title: 'Understand the work',
          text: 'Map the workflow, the people and the constraints. Agree what a useful result looks like.',
        },
        {
          n: '02',
          title: 'Connect the decisions',
          text: 'Bring applications, data and infrastructure into a coherent scope, with dependencies made visible.',
        },
        {
          n: '03',
          title: 'Build for the handover',
          text: 'Plan implementation, validation and operations together, so the next team can take ownership.',
        },
      ].map((x) => (
        <article>
          <span class="step-number">{x.n}</span>
          <h3>{x.title}</h3>
          <p>{x.text}</p>
        </article>
      ))}
    </div>
    <a class="text-link" href="/company/how-we-work/" style="margin-top:32px">
      Explore discovery, delivery and handover <Icon />
    </a>
  </section>
  <section class="portfolio">
    <div class="wrap">
      <div class="section-heading">
        <h2>
          Specialist thinking.
          <br />
          <em>Distinct products.</em>
        </h2>
        <p>
          Three focused brands in the Soft Task portfolio.
          <br />
          Each with a different job to do.
        </p>
      </div>
      <div class="product-grid">
        {products.map((p) => (
          <a class:list={['product-card', p.color]} href={p.path}>
            <div class="product-top">
              <span>{p.label}</span>
              <Icon name="diagonal" />
            </div>
            <h3>
              {p.name}
              <span>.</span>
            </h3>
            <p>{p.description}</p>
            <span class="product-link">Explore {p.name}</span>
          </a>
        ))}
      </div>
      <p class="portfolio-note">
        Explore current features and availability on each product’s website.
      </p>
    </div>
  </section>
  <section class="section wrap insights-home">
    <div class="section-heading">
      <h2>
        A closer look
        <br />
        at what matters.
      </h2>
      <a class="text-link" href="/insights/">
        Explore perspectives <Icon />
      </a>
    </div>
    <div class="editorial-grid">
      <a class="feature-story" href={`/insights/${articles[0].slug}/`}>
        <div class="story-image">
          <Photo name="server" alt="Connected server racks illustrating workload dependencies" />
          <span class="story-category">Infrastructure</span>
        </div>
        <div class="feature-story-copy">
          <h3>{articles[0].title}</h3>
          <Icon name="diagonal" size={30} />
        </div>
        <p>{articles[0].summary}</p>
      </a>
      <div class="story-list">
        {articles.slice(1).map((a) => (
          <a href={`/insights/${a.slug}/`}>
            <span class="meta">
              {a.category} / {a.minutes} min read
            </span>
            <h3>{a.title}</h3>
            <span class="text-link">
              Read the perspective <Icon />
            </span>
          </a>
        ))}
        <a class="newsletter-teaser" href="/newsletter/">
          <span>A little more perspective.</span>
          <strong>
            Good questions.
            <br />
            Useful reading.
          </strong>
          <span class="text-link">
            Subscribe to updates <Icon />
          </span>
        </a>
      </div>
    </div>
  </section>
  <section class="global-section">
    <div class="wrap global-inner">
      <div>
        <h2>
          One company.
          <br />A local conversation.
        </h2>
        <p>
          With Singapore as our headquarters, our country websites bring the conversation closer to
          your market.
        </p>
        <a class="text-link" href="/company/locations/">
          Explore our locations <Icon />
        </a>
      </div>
      <div class="market-list">
        <a href="https://softtask.sg">
          <span>
            Singapore<small>Headquarters</small>
          </span>
          <Icon name="diagonal" />
        </a>
        <a href="https://softtask.ae">
          United Arab Emirates
          <Icon name="diagonal" />
        </a>
        <a href="https://softtask.in">
          India
          <Icon name="diagonal" />
        </a>
        <span class="planned-market">
          Saudi Arabia<small>Planned</small>
        </span>
      </div>
    </div>
  </section>
  <ContactBand />
<section class="section wrap"><h2>Find the connection to your industry.</h2><p>From manufacturing and logistics to retail, professional services and digital infrastructure, explore the workflows technology can help improve.</p><div class="connection-links"><a href="/industries/">Who we serve</a><a href="/solutions/">Problems we can work on</a><a href="/services/">All 15 capability pillars</a></div></section>
</Layout>
