---
import Layout from '../../../layouts/Layout.astro';
import {presence} from '../../../data/presence';
export function getStaticPaths(){return presence.map(location=>({params:{country:location.id},props:{location}}));}
const {location:p}=Astro.props;
const profiles:Record<string,{heading:string;intro:string;focus:string[]}>={
 singapore:{heading:'Our headquarters. Your starting point.',intro:'Singapore is the headquarters of Soft Task and a starting point for regional and international technology engagements. We connect your business priorities with the engineering disciplines, delivery ownership and communication your project needs.',focus:['Plan a regional or international technology programme.','Connect software, AI, cloud and cybersecurity around one delivery scope.','Coordinate working hours, data requirements and stakeholder decisions across markets.']},
 india:{heading:'Technology conversations in Bengaluru.',intro:'Our India presence connects business requirements with software, data and infrastructure engineering. Share the workflow you want to improve, the systems involved and the people who will use the result.',focus:['Develop and modernise business applications.','Connect enterprise systems, data and automation.','Plan implementation, testing and operational handover.']},
 uae:{heading:'A direct conversation for your UAE requirements.',intro:'Contact Soft Task for technology requirements in the United Arab Emirates. We scope each engagement around the business workflow, existing platforms and the operational and local requirements relevant to your organisation.',focus:['Connect business applications and enterprise workflows.','Assess AI, data, cloud and cybersecurity priorities.','Discuss financial and compliance workflows alongside the Regulix One product team.']},
 usa:{heading:'Connect your US requirements with Soft Task.',intro:'Use our United States contact address and dedicated email to start a technology conversation. Our Singapore-headquartered team works with you to define delivery responsibilities, working hours and the systems and data involved.',focus:['Discuss custom software, AI and platform engineering.','Plan cross-border delivery and agreed support coverage.','Connect cloud, integration and cybersecurity requirements.']},
 saudi:{heading:'Launching into the Saudi market soon.',intro:'Soft Task is preparing its Saudi market presence. You can speak with our global team now about a future requirement, and we will discuss the scope and arrangements relevant to your project.',focus:['Share your business priorities and intended timeline.','Explore software, AI, infrastructure and security requirements.','Agree the next conversation with our global team.']},
};
const content=profiles[p.id];
---
<Layout title={`Soft Task ${p.name} — ${p.role}`} description={`${content.intro} Contact ${p.email}.`}>
 <header class="wrap location-hero"><nav aria-label="Breadcrumb"><a href="/company/">Company</a> / <a href="/company/locations/">Our presence</a></nav><p class="location-role">{p.role}</p><h1>Soft Task<br/>{p.name}</h1><p class="location-intro">{content.heading}</p></header>
 <section class="wrap location-details"><div><h2>Start a conversation.</h2><p>{content.intro}</p><ul>{content.focus.map(item=><li>{item}</li>)}</ul><a class="button primary" href={`/contact/?country=${encodeURIComponent(p.id==='usa'?'United States':p.name)}`}>Discuss your requirement</a></div><aside><h2>{p.id==='saudi'?'Market launch':'Contact details'}</h2><p>{p.role}</p>{p.address&&<address>{p.address}</address>}<a class="location-email" href={`mailto:${p.email}`}>{p.email}</a>{p.id==='saudi'&&<p>Launching soon. Contact our global team for enquiries.</p>}<p>For a visit or meeting, please contact the team first to agree the arrangements.</p></aside></section>
 <section class="wrap location-next"><h2>Explore what we can do together.</h2><div><a href="/services/">Our 15 capabilities</a><a href="/industries/">Technology for your industry</a><a href="/company/how-we-work/">How we work</a><a href="/services/cybersecurity/">Soft Task cybersecurity</a></div></section>
</Layout>
<style>.location-hero{padding-block:60px 44px}.location-hero nav{font-size:14px}.location-role{margin-top:36px;font-weight:600}.location-hero h1{font-size:clamp(40px,5vw,72px);margin:20px 0;max-width:23ch}.location-intro{font-size:23px;max-width:50ch}.location-details{display:grid;grid-template-columns:1.3fr 1fr;gap:70px;padding-block:30px 70px}.location-details h2,.location-next h2{font-size:30px}.location-details p{max-width:65ch}.location-details ul{padding-left:20px;margin-block:28px}.location-details li{margin-block:14px}.location-details aside{background:#e5eddf;padding:32px;align-self:start}.location-details address{font-style:normal;margin-block:24px;line-height:1.8}.location-email{display:block;font-size:clamp(18px,2vw,26px);font-weight:600;overflow-wrap:anywhere;text-decoration:underline;margin-block:24px}.location-next{padding-block:40px 70px;border-top:1px solid var(--line)}.location-next>div{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:28px}.location-next a{padding:22px;background:#e5eddf;text-decoration:underline}@media(max-width:760px){.location-hero{padding-top:36px}.location-details{grid-template-columns:1fr;gap:30px}.location-details aside{padding:24px}.location-next>div{grid-template-columns:1fr}}</style>
