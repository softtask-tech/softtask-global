---
import Layout from '../layouts/Layout.astro';
const policies = {
  privacy: {
    title: 'Privacy information',
    intro: 'Understand what this website asks for and how its features are intended to use it.',
    sections: [
      [
        'Current website status',
        'This is a development version. The enquiry and subscription services are not active until the company operator, processing details and providers are confirmed. Do not submit confidential or sensitive information.',
      ],
      [
        'Enquiries',
        'The enquiry form asks for your name, work email, company, market, selected capability and project description. When activated, this information will be used to assess and respond to your request. It is separate from newsletter consent.',
      ],
      [
        'Email subscriptions',
        'A subscription requires a confirmation link sent to the supplied email address. Confirmed preferences determine the selected topics. Every update must provide an unsubscribe option.',
      ],
      [
        'Storage and optional tracking',
        'This version stores cookie preferences in your browser for up to 180 days. It does not install analytics or advertising tags. Your choices can be changed using Cookie settings in the footer.',
      ],
      [
        'Before public launch',
        'The final notice must identify the responsible legal entity, contact address, retention periods, service providers, international processing arrangements and applicable rights. These details remain subject to confirmation; this development notice is not a completed legal policy.',
      ],
    ],
  },
  terms: {
    title: 'Website terms',
    intro: 'Information about the scope and use of this development website.',
    sections: [
      [
        'General information',
        'Website content describes areas for discussion. It does not create a contract, warranty or commitment to a particular scope, delivery date, support level or business outcome. Engagement terms are agreed separately.',
      ],
      [
        'Products and other websites',
        'Links to Tubblor, Regulix One, Kytheos and regional websites lead to separate websites with their own product availability, terms and operators.',
      ],
      [
        'Technical perspectives',
        'Articles provide general explanations. They are not a substitute for a project-specific assessment or professional advice where required.',
      ],
      [
        'Publication review',
        'These terms are a development draft. The responsible entity, applicable law and final terms must be reviewed before public launch.',
      ],
    ],
  },
  cookies: {
    title: 'Cookie information',
    intro: 'Small preferences. Clear choices.',
    sections: [
      [
        'Essential browser storage',
        'The key softtask-consent-v1 records your choices in local browser storage. It expires after 180 days. It is used only to remember these settings. Clearing your browser storage removes it.',
      ],
      [
        'Analytics and marketing',
        'No analytics or advertising tags are currently installed. The controls record your preferences; they do not activate a tracking provider in this build. New tools or materially changed purposes require an updated notice and consent review.',
      ],
      [
        'Change your choices',
        'Use Cookie settings in the footer to reopen the preferences. Accept optional and Reject optional are equally available. You can also choose analytics and marketing independently.',
      ],
      [
        'Requested features',
        'When forms are activated, spam-prevention and email services may process information needed to fulfil your request. The final privacy and cookie notices must describe the actual providers and their behaviour before launch.',
      ],
    ],
  },
  accessibility: {
    title: 'Accessibility',
    intro: 'A website should work for the person using it.',
    sections: [
      [
        'Our design approach',
        'This build includes semantic page structure, keyboard-operated navigation, visible focus indicators, labelled form controls, reduced-motion support and readable responsive layouts.',
      ],
      [
        'Ongoing verification',
        'Automated and manual checks are part of development. An accessibility target is not a certification, and automated checks do not establish complete conformance.',
      ],
      [
        'Report an issue',
        'When contacting Soft Task, describe the page, what you were trying to do and the assistive technology or browser involved. Do not include private account information. A dedicated monitored accessibility contact must be confirmed before launch.',
      ],
    ],
  },
};
export function getStaticPaths() {
  return ['privacy', 'terms', 'cookies', 'accessibility'].map((policy) => ({ params: { policy } }));
}
const p = policies[Astro.params.policy as keyof typeof policies];
---

<Layout title={p.title}>
  <section class="page-hero">
    <div class="wrap">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/ {p.title}</span>
      </div>
      <h1>{p.title}.</h1>
      <p class="lead">{p.intro}</p>
    </div>
  </section>
  <section class="section wrap prose">
    {p.sections.map(([title, body]) => (
      <section>
        <h2>{title}</h2>
        <p>{body}</p>
      </section>
    ))}
  </section>
</Layout>
