---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Screen from '../../components/Screen.astro';
import Workflow from '../../components/Workflow.astro';
import { flows } from '../../data/flows';
---

<Layout
  title="Kytheos Guardian — cybersecurity product in beta"
  description="Explore Kytheos Guardian, a Soft Task cybersecurity product in public beta. Learn about its assessment workflow and the wider portfolio in development."
  dark
>
  <section class="kytheos-cover">
    <div class="wrap">
      <div class="breadcrumb">
        <a href="/products/">Products</a>
        <span>/ Kytheos</span>
      </div>
      <div class="kytheos-cover-grid">
        <div>
          <p class="product-label">Kytheos</p>
          <h1>
            Security signals.
            <br />
            Understood.
          </h1>
          <p class="lead">
            Cybersecurity should help people understand what they are seeing and what to do next.
            Kytheos Guardian is our public beta product for exploring security signals. The wider product portfolio is in development.
          </p>
          <a class="button light" href="https://kytheos.com/">
            Explore Kytheos <Icon name="diagonal" />
          </a>
        </div>
        <div class="signal-verdict" data-draw>
          <p>Evidence before a decision</p>
          <div>
            <span>Input</span>
            <strong>A suspicious link or message</strong>
          </div>
          <svg viewBox="0 0 300 45" aria-hidden="true">
            <path class="route-line" d="M150 0V45" />
          </svg>
          <div>
            <span>Assessment</span>
            <strong>Signals, context and uncertainty</strong>
          </div>
          <svg viewBox="0 0 300 45" aria-hidden="true">
            <path class="route-line" d="M150 0V45" />
          </svg>
          <div class="verdict-outcome">
            <span>Explanation</span>
            <strong>A clearer next step</strong>
          </div>
          <small>Guardian assessment workflow</small>
        </div>
      </div>
    </div>
  </section>
  <section class="guardian-story wrap">
    <div>
      <p class="product-label">Start with Guardian</p>
      <h2>
        A question people
        <br />
        ask every day:
        <br />
        <em>is this safe?</em>
      </h2>
      <p>
        Guardian is Kytheos’s first public product, available in beta. It helps assess suspicious
        links, emails and files and presents an explanation of the available signals.
      </p>
      <p>
        Evidence may be incomplete. A result should be read with its context and limitations, rather
        than treated as a guarantee that an item is safe.
      </p>
      <a class="text-link" href="https://kytheos.com/guardian">
        Open Guardian <Icon name="diagonal" />
      </a>
    </div>
    <Screen
      name="kytheos"
      alt="Kytheos Guardian illustrative suspicious-link analysis on the product website"
      caption="Kytheos Guardian product interface example."
    />
  </section>
  <section class="security-architecture">
    <div class="wrap">
      <div class="section-heading">
        <h2>
          From signal
          <br />
          to a tracked response.
        </h2>
        <p>
          A wider security architecture connects evidence, review and ownership. The supplied
          security schematic informs this conceptual workflow.
        </p>
      </div>
      <Workflow
        id="security-flow"
        title="A security response architecture"
        variant="dark"
        steps={flows.security}
        caption="Architecture illustration only. It does not imply that the entire Kytheos ecosystem is currently available."
      />
    </div>
  </section>
  <section class="strid-feature wrap">
    <div class="strid-title"><span>Services by Soft Task</span><h2>Need a security team?</h2></div>
    <div><h3>Speak directly with Soft Task.</h3><p>Soft Task manages cybersecurity services and STRID crypto investigation engagements. Explore penetration testing, cloud and identity security, incident response, digital forensics and security architecture with our team.</p><a class="text-link" href="/services/cybersecurity/">Explore Soft Task cybersecurity services <Icon name="diagonal" /></a></div>
  </section>
  <section class="ecosystem-status wrap">
    <h2>
      A focused start.
      <br />A developing ecosystem.
    </h2>
    <div>
      <article>
        <span>Public beta</span>
        <h3>Guardian</h3>
        <p>
          Suspicious-link, email and file assessment with an explanation of the available evidence.
        </p>
      </article>
      <article>
        <span>In development</span>
        <h3>The wider Kytheos portfolio</h3>
        <p>
          The product website describes further modules for teams. Guardian is available in public beta; further modules are in development.
        </p>
      </article>
    </div>
    <a class="button" href="https://kytheos.com/products">
      View the Kytheos ecosystem <Icon name="diagonal" />
    </a>
  </section>
<section class="section wrap"><h2>Speak with the product team</h2><p>Email <a href="mailto:kytheos@softtask.co">kytheos@softtask.co</a> for product enquiries and coordination.</p></section>

</Layout>
