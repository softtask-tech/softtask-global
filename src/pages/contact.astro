---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { policyVersion } from '../data/governance';
import catalogue from '../data/catalogue.json';
import { getCountries, getCountryCallingCode } from 'libphonenumber-js/min';
const countryNames = new Intl.DisplayNames(['en'], { type: 'region' });
const phoneCountries = getCountries().map(code => ({code, name:countryNames.of(code) || code, dial:getCountryCallingCode(code)})).sort((a,b)=>a.name.localeCompare(b.name));
---

<Layout
  title="Discuss your project"
  description="Tell Soft Task about your software, AI, data or infrastructure project."
>
  <section class="page-hero">
    <div class="wrap">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/ Contact</span>
      </div>
      <h1>
        Every good project
        <br />
        starts with <em>a conversation.</em>
      </h1>
      <p class="lead">
        Tell us what you are working towards, what is getting in the way, and where you want to
        begin.
      </p>
    </div>
  </section>
  <section class="section wrap form-layout">
    <aside class="form-context">
      <h2>Email us or use the form.</h2>
      <p>Choose whichever is easier. A short description of the challenge is enough to begin.</p>
      <a class="direct-email" href="mailto:contact@softtask.co">contact@softtask.co</a>
      <p>For project and sales enquiries.</p>
      <details class="contact-next"><summary>What happens next?</summary><p>We review your requirement, identify the relevant disciplines and arrange the next conversation. Scope, timing and commercial terms follow that assessment.</p><p>Please keep confidential records out of the initial enquiry.</p></details>
      <a class="text-link" href="/company/locations/">Find our regional contacts <Icon /></a>
    </aside>
    <form class="form-grid enquiry-form" data-endpoint="/api/contact" method="post" action="/api/contact">
      <input type="hidden" name="noticeVersion" value={policyVersion} />
      <div class="form-heading full"><h2>Your contact details</h2><p>Fields are required unless marked optional.</p></div>
      <label class="field">
        Your name
        <input name="name" required maxlength="120" autocomplete="name" />
      </label>
      <label class="field">
        Work email
        <input name="email" type="email" required maxlength="254" autocomplete="email" />
      </label>
      <label class="field">
        Company
        <input name="company" required maxlength="160" autocomplete="organization" />
      </label>
      <label class="field">
        Country / market
        <select name="country" required>
          <option value="">Choose a market</option>
          <option>Global / multiple markets</option>
          <option>Singapore</option>
          <option>United Arab Emirates</option>
          <option>India</option>
          <option>United States</option>
          <option>Saudi Arabia</option>
          <option>Other</option>
        </select>
      </label>
      <div class="field full phone-field">
        <span>Phone number <span class="optional">(optional)</span></span>
        <div class="phone-fields">
          <select name="phoneCountry" aria-label="Phone country code" autocomplete="tel-country-code"><option value="">Country code</option>{phoneCountries.map(c=><option value={c.code}>{c.name} (+{c.dial})</option>)}</select>
          <input name="phone" type="tel" inputmode="tel" autocomplete="tel-national" maxlength="40" aria-label="Phone number without country code" aria-describedby="phone-hint" placeholder="Number without country code" />
        </div>
        <span id="phone-hint" class="field-hint">Include the area code where needed. We will use this number only for your enquiry.</span>
      </div>
      <div class="form-heading full project-heading"><h2>Tell us about the project</h2><p>Start with the outcome you need. We can help define the technical scope.</p></div>
      <label class="field full">
        What would you like to discuss?
        <select name="service" required>
          <option value="">Choose a capability</option>
          {['Build & connect','Intelligence & data','Platforms & operations','Specialist products'].map(group=><optgroup label={group}>{catalogue.pillars.filter(p=>p.group===group).map(p=><option value={p.id}>{p.title}</option>)}</optgroup>)}
          <option value="not-sure">Help me define the scope</option>
        </select>
      </label>
      <details class="full optional-context" data-optional-context><summary>Add industry context (optional)</summary><div class="form-grid">
      <label class="field">Your industry (optional)<select name="industry"><option value="">Choose an industry</option>{catalogue.industries.map(i=><option value={i.id}>{i.title}</option>)}</select></label>
      <label class="field">Workflow of interest (optional)<select name="scenario"><option value="">Describe it in your message</option>{catalogue.scenarios.map(s=><option value={s.id} data-industry={s.industry}>{s.title}</option>)}</select></label>
      </div></details>
      <p class="enquiry-context" data-enquiry-context hidden></p>
      <label class="field full">
        A little about the project
        <textarea
          name="message" aria-describedby="message-help message-count"
          required
          minlength="20"
          maxlength="5000"
          placeholder="What needs to change? Include any useful context, without confidential or sensitive information."
        ></textarea>
        <span class="message-guidance"><span id="message-help">At least 20 characters. No confidential information.</span><span id="message-count">0 / 5,000</span></span>
      </label>
      <label class="checkbox-field consent-panel">
        <input type="checkbox" name="consent" required />
        <span>
          I agree to the <a href="/terms/">website terms</a> and have read the
          <a href="/privacy/"> privacy policy</a>. I consent to Soft Task using my submitted
          details to assess and contact me about this enquiry and related project discussions.
          This does not subscribe me to marketing emails.
        </span>
      </label>
      <div class="sr-only" aria-hidden="true">
        <label>
          Leave this empty
          <input name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <div class="verification-area"><div class="turnstile-mount" data-action="contact"></div></div>
      <p class="form-status" role="status" tabindex="-1" hidden></p>
      <button type="submit" class="button primary form-submit">
        Send your enquiry <Icon />
      </button>
      <p class="form-note">
        Online submission is awaiting activation. Your information is not sent until the service is
        connected.
      </p>
    </form>
  </section>
</Layout>

<style>
.direct-email{display:block;font-size:clamp(18px,2vw,25px);font-weight:600;text-decoration:underline;margin:20px 0 6px;overflow-wrap:anywhere}.contact-next{padding-block:14px;border-block:1px solid var(--line);font-size:14px}.contact-next summary,.optional-context summary{cursor:pointer;font-weight:600}.optional-context .form-grid{padding-top:18px}.optional-context{padding:14px;background:#f3f6ef;font-size:14px}.message-guidance{display:flex;justify-content:space-between;gap:16px;font-size:12px;line-height:1.5;font-weight:400;color:var(--muted)}#message-count{white-space:nowrap}.page-hero{padding-block:42px}.page-hero h1{font-size:clamp(32px,4vw,54px)}
  .form-layout{grid-template-columns:minmax(240px,.7fr) minmax(0,1.3fr);gap:clamp(32px,5vw,80px);align-items:start}
  .enquiry-form{background:#fff;padding:clamp(20px,3vw,40px);border:1px solid #d5ded4;border-top:4px solid var(--forest);gap:18px;min-width:0}
  .full,.verification-area{grid-column:1/-1;min-width:0}
  .form-heading h2{font-size:24px;line-height:1.25;margin:0 0 8px}
  .form-heading p,.field-hint{font-size:13px;color:var(--muted);line-height:1.6;margin:0;font-weight:400}
  .project-heading{padding-top:18px;border-top:1px solid #d5ded4;margin-top:6px}
  .enquiry-form .field{font-size:14px;min-width:0}
  .enquiry-form input,.enquiry-form select,.enquiry-form textarea{font-size:16px;min-height:50px;min-width:0;background:#fafbf8;border-color:#a9b7ad;border-radius:4px}
  .enquiry-form textarea{min-height:110px;line-height:1.6}
  .enquiry-form input:focus,.enquiry-form select:focus,.enquiry-form textarea:focus{outline:2px solid var(--forest);outline-offset:2px;background:white}
  .phone-fields{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:12px}
  .optional{font-weight:400;color:var(--muted)}
  .consent-panel{padding:18px;background:#f0f4ed;font-size:13px;border-radius:4px;line-height:1.7}
  .consent-panel input{min-height:20px;width:20px;height:20px;margin-top:2px}
  .verification-area{min-width:0;max-width:100%}
  .form-note{font-size:12px;line-height:1.6;margin:0}
  .form-submit{width:100%;justify-content:space-between;min-height:54px;border-radius:4px}
  @media(max-width:1000px){.form-layout{grid-template-columns:1fr}.form-context{max-width:680px}.form-context ul{display:none}}
  @media(max-width:600px){.enquiry-form{grid-template-columns:minmax(0,1fr);padding:20px 16px;gap:16px}.phone-fields{grid-template-columns:minmax(0,1fr)}.form-heading h2{font-size:22px}.consent-panel{padding:14px}.form-layout{padding-top:32px}.form-context h2{font-size:28px}.enquiry-form .field{grid-column:1/-1}}
</style>
