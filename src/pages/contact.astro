---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/services';
---

<Layout
  title="Discuss your project"
  description="Tell Soft Task about your software, AI, data or infrastructure project."
>
  <section class="page-hero">
    <div class="wrap">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/ Contact</span>
      </div>
      <h1>
        Every good project
        <br />
        starts with <em>a conversation.</em>
      </h1>
      <p class="lead">
        Tell us what you are working towards, what is getting in the way, and where you want to
        begin.
      </p>
    </div>
  </section>
  <section class="section wrap form-layout">
    <aside class="form-context">
      <h2>
        Bring the challenge.
        <br />
        We’ll start there.
      </h2>
      <p>
        You do not need a complete specification to start. A little context helps us understand
        which capabilities the conversation needs.
      </p>
      <ul>
        <li>The business problem or intended outcome</li>
        <li>Your current systems and constraints</li>
        <li>The market and timeframe for the work</li>
      </ul>
      <h3>What comes next</h3>
      <p>Prefer email? Write to <a href="mailto:contact@softtask.co">contact@softtask.co</a>.</p>
      <p>
        The first conversation establishes the requirement, identifies relevant technical
        disciplines and clarifies what information is needed to define a scope. Delivery dates and
        commercial terms follow that assessment.
      </p>
      <p>
        Keep the initial description at a business level. Agree a suitable sharing method before
        providing confidential documents or system access.
      </p>
      <a class="text-link" href="/company/locations/">
        Looking for a local conversation? <Icon />
      </a>
    </aside>
    <form class="form-grid" data-endpoint="/api/contact" method="post" action="/api/contact">
      <label class="field">
        Your name
        <input name="name" required maxlength="120" autocomplete="name" />
      </label>
      <label class="field">
        Work email
        <input name="email" type="email" required maxlength="254" autocomplete="email" />
      </label>
      <label class="field">
        Company
        <input name="company" required maxlength="160" autocomplete="organization" />
      </label>
      <label class="field">
        Country / market
        <select name="country" required>
          <option value="">Choose a market</option>
          <option>Global / multiple markets</option>
          <option>Singapore</option>
          <option>United Arab Emirates</option>
          <option>India</option>
          <option>United States</option>
          <option>Saudi Arabia</option>
          <option>Other</option>
        </select>
      </label>
      <label class="field full">
        What would you like to discuss?
        <select name="service" required>
          <option value="">Choose a capability</option>
          {services.map((s) => (
            <option value={s.slug}>{s.name}</option>
          ))}
          <option value="not-sure">Help me define the scope</option>
        </select>
      </label>
      <label class="field full">
        A little about the project
        <textarea
          name="message"
          required
          minlength="20"
          maxlength="5000"
          placeholder="What needs to change? Include any useful context, without confidential or sensitive information."
        ></textarea>
      </label>
      <label class="checkbox-field">
        <input type="checkbox" name="consent" required />
        <span>
          I have read the <a href="/privacy/">privacy information</a> and agree to be contacted
          about this enquiry.
        </span>
      </label>
      <div class="sr-only" aria-hidden="true">
        <label>
          Leave this empty
          <input name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <div class="turnstile-mount" data-action="contact"></div>
      <p class="form-status" role="status" tabindex="-1" hidden></p>
      <button type="submit" class="button primary form-submit">
        Send your enquiry <Icon />
      </button>
      <p class="form-note">
        Online submission is awaiting activation. Your information is not sent until the service is
        connected.
      </p>
    </form>
  </section>
</Layout>
