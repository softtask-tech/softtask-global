---
import Layout from '../../layouts/Layout.astro';
import SectorMark from '../../components/SectorMark.astro';
import {solutions} from '../../data/discovery';
import catalogue from '../../data/catalogue.json';
export function getStaticPaths(){return solutions.map(solution=>({params:{slug:solution.slug},props:{solution}}));}
const {solution:s}=Astro.props;
const industry=catalogue.industries.find(i=>i.id===s.industry)!;
const pillars=catalogue.pillars.filter(p=>industry.pillars.includes(p.id));
const related=solutions.filter(other=>other.industry===s.industry&&other.id!==s.id);
---
<Layout title={s.searchTitle} description={`Explore ${s.searchTitle.toLowerCase()} with Soft Task.`}>
  <header class="wrap problem-hero"><div><nav aria-label="Breadcrumb"><a href="/solutions/">Business problems</a><span> / </span><a href={`/industries/${industry.id}/`}>{industry.title}</a></nav><h1>{s.searchTitle}</h1><p class="lead">{s.title}</p><p class="problem-label">Solution brief · Illustrative opportunity</p></div><SectorMark kind={industry.visual}/></header>
  <section class="wrap problem-brief"><aside><h2>The business problem</h2><p>{s.problem}</p><p>Prepared by Soft Task. This brief describes a possible approach, not a completed client project or a guaranteed outcome.</p><a class="button primary" href={`/contact/?industry=${industry.id}&scenario=${s.id}`}>Discuss this workflow</a></aside><div><h2>What Soft Task could build</h2><p class="build-answer">{s.build}</p><div class="decision-pair"><section><h3>Where AI can help</h3><p>{s.ai}</p></section><section><h3>Where people stay in control</h3><p>{s.boundary}</p></section></div><h2>Define a measurable pilot</h2><p>{s.measure}</p><p>Agree the current baseline and a representative sample before development. Evaluate false positives, missed cases, review effort and failure handling alongside useful results. Use those findings to decide what to change, expand or stop.</p></div></section>
  <section class="wrap problem-steps"><h2>From an operational gap to a testable workflow</h2><ol><li><h3>Map the handoffs</h3><p>Follow {industry.steps.map(step=>step.toLowerCase()).join(' → ')}. Identify the information each team needs and where ownership changes.</p></li><li><h3>Check the evidence</h3><p>Identify authoritative records, update frequency and missing fields. Confirm who may view, change or export them. Agree the treatment of confidential data before integration.</p></li><li><h3>Test the exceptions</h3><p>Run the ordinary path and the cases that currently cause delays. Keep a human review path, record decisions and test recovery when a source system is unavailable.</p></li></ol></section>
  <section class="wrap problem-links"><h2>Capabilities for this workflow</h2><p>The final combination depends on your systems, scope and operational constraints.</p><div>{pillars.map(p=><a href={p.url}>{p.title}</a>)}</div><p><a href="/services/ai-automation/responsible-ai/">AI guardrails and evaluation</a> · <a href="/company/how-we-work/">Our delivery approach</a></p>{related.map(other=><p>Related problem: <a href={other.url}>{other.searchTitle}</a></p>)}</section>
</Layout>
<style>.problem-hero{display:grid;grid-template-columns:1.6fr .6fr;align-items:center;gap:60px;padding-block:64px}.problem-hero h1{font-size:clamp(34px,4.2vw,62px);line-height:1.07;margin:24px 0}.problem-hero nav,.problem-label{font-size:13px}.problem-hero :global(svg){width:100%;max-height:240px;color:var(--forest)}.problem-brief{display:grid;grid-template-columns:.8fr 1.4fr;gap:64px;padding-block:48px;border-top:1px solid var(--line)}h2{font-size:28px;line-height:1.25}h3{font-size:20px;line-height:1.4}p{line-height:1.8;color:var(--muted);font-size:16px}.build-answer{font-size:23px;color:var(--forest)}aside{background:#e6eddf;padding:28px;height:fit-content}.decision-pair{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-block:32px}.decision-pair section{border-top:3px solid var(--forest);padding-top:12px}.decision-pair section+section{border-color:#dd8755}.problem-steps{padding-block:40px}.problem-steps ol{display:grid;grid-template-columns:repeat(3,1fr);gap:36px;padding-left:24px}.problem-links{padding-block:40px 64px}.problem-links div{display:flex;flex-wrap:wrap;gap:12px}.problem-links a{text-decoration:underline}.problem-links div a{padding:14px;background:#e6eddf}@media(max-width:760px){.problem-hero{grid-template-columns:1fr;padding-block:40px;gap:20px}.problem-hero :global(svg){max-height:140px}.problem-brief{grid-template-columns:1fr;gap:32px}.decision-pair,.problem-steps ol{grid-template-columns:1fr;gap:20px}h2{font-size:25px}}</style>
