---
import Layout from '../../layouts/Layout.astro';
import SectorMark from '../../components/SectorMark.astro';
import catalogue from '../../data/catalogue.json';
import '../../styles/catalogue.css';
---
<Layout title="Who we serve: industry solutions" description="Explore Soft Task technology opportunities across manufacturing, logistics, retail, healthcare, financial services and other industries. Start with a business problem.">
<header class="catalogue-hero wrap"><div><span>Who we serve</span><h1>Technology that understands the work.</h1><p>Find your industry. Recognise a problem. See the system we could build, the information it needs and the decisions your team keeps.</p><a class="text-link" href="/solutions/">Prefer to start with a problem?</a></div><div class="catalogue-illustration"><SectorMark kind="network"/><span>People · information · decisions · systems</span></div></header>
<section class="wrap industry-directory" data-catalogue-filter><div class="catalogue-filter"><label for="industry-search">Find an industry or problem<input id="industry-search" data-filter-input type="search" placeholder="Try pharmacy, shipping, education or stock" autocomplete="off" /></label><p data-filter-count role="status">16 industry families</p></div><div class="industry-grid">{catalogue.industries.map(i=><article data-filter-item data-search={[i.title,...i.sectors,...catalogue.scenarios.filter(s=>s.industry===i.id).map(s=>s.title)].join(' ').toLowerCase()}><a href={`/industries/${i.id}/`}><SectorMark kind={i.visual}/><h2>{i.title}</h2><p>{i.description}</p><span>Explore the workflows ↗</span></a><details><summary>Industries in this family</summary><ul>{i.sectors.map(s=><li>{s}</li>)}</ul></details></article>)}</div><p data-filter-empty hidden>No matching industry yet. Try a broader term or <a href="/contact/">tell us about your work</a>.</p></section>
<section class="wrap catalogue-bottom"><h2>One project can connect several disciplines.</h2><p>Our 15 capability pillars sit behind these industry workflows. You can begin with the business problem and shape the technical scope with us.</p><a class="button" href="/services/">Explore what we do</a></section>
</Layout>
