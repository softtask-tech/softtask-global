---
import Layout from '../../layouts/Layout.astro';
import CapabilityConnections from '../../components/CapabilityConnections.astro';
const services = [
  ['Security architecture & zero trust', 'Make access a deliberate decision.', 'Review identity, devices, network boundaries and sensitive data. Design least-privilege access, segmentation, conditional access and privileged-access workflows around the systems your people actually use.', 'Architecture review, prioritised control roadmap, access model and validation plan.'],
  ['Penetration testing & exposure management', 'Find the route an attacker could take.', 'Assess web applications, APIs, mobile applications, networks and cloud configurations. Combine authorised testing with vulnerability prioritisation, attack-path analysis and remediation verification.', 'Agreed rules of engagement, reproducible findings, business impact and remediation retest.'],
  ['Detection, monitoring & response', 'Turn security alerts into decisions.', 'Connect endpoint, identity, cloud and network signals through EDR, XDR and SIEM workflows. Tune detections, investigate alerts and develop response playbooks with clear escalation and service coverage.', 'Detection use cases, integration design, triage runbooks and an agreed operating model.'],
  ['Incident response & digital forensics', 'Preserve evidence. Restore control.', 'Support incident scoping, containment planning, forensic collection, timeline reconstruction and recovery coordination. Work with your authorised incident owners to document decisions and preserve evidence integrity.', 'Incident timeline, evidence register, containment recommendations and recovery priorities.'],
  ['Cloud, infrastructure & identity security', 'Reduce unnecessary access and exposure.', 'Review cloud posture, Kubernetes and container configurations, infrastructure permissions, secrets, network controls and backup protection. Connect identity lifecycle management with infrastructure change and recovery workflows.', 'Configuration findings, hardened baselines, privilege review and recovery checks.'],
  ['Application security & DevSecOps', 'Build security into the release.', 'Integrate threat modelling, secure code review, dependency analysis, SAST, DAST and secrets scanning into development. Help teams prioritise exploitable findings and define release checks with accountable exceptions.', 'Threat model, security checks in delivery pipelines and developer remediation guidance.'],
  ['OT, IoT & industrial security', 'Protect operations with their constraints in view.', 'Map industrial assets and trust boundaries, review remote access and segment operational networks. Plan assessment methods with plant engineers around availability, equipment safety and approved maintenance windows.', 'Asset and access map, segmentation recommendations and an operationally agreed assessment plan.'],
  ['Threat intelligence & security readiness', 'Connect external threats to your exposure.', 'Assess relevant threats, brand impersonation and exposed assets. Develop incident exercises, phishing-awareness programmes, supplier security reviews and evidence-led risk reporting for technical and business teams.', 'Relevant threat briefings, readiness exercises, ownership and prioritised actions.'],
  ['AI application security', 'Give AI a defined operating boundary.', 'Assess prompt injection, sensitive-data exposure, tool permissions and retrieval access. Build evaluation cases, output handling and human approval into AI workflows, and review logging and escalation when evidence is weak.', 'Abuse-case assessment, scoped tool permissions, evaluation set and documented guardrails.'],
  ['Data protection & email security', 'Protect information where it moves.', 'Review data classification, encryption, DLP controls and email authentication. Strengthen controls around sensitive exports, account impersonation and business email compromise, with investigation and exception workflows for your team.', 'Data-flow review, email security findings, protection rules and exception ownership.'],
  ['Security governance & assurance readiness', 'Make control ownership visible.', 'Translate business risks and contractual requirements into a control plan. Review supplier dependencies, organise control evidence and prepare security exercises with technical teams, leadership and the relevant assurance specialists.', 'Risk register, control ownership, evidence checklist and a prioritised improvement plan.'],
];
const cases = [
  {id:'identity', industry:'financial-services', title:'A valid login reaches too much', problem:'A compromised employee or supplier account can cross systems before anyone sees the business impact.', approach:'Map permissions and privileged paths, enforce stronger authentication, reduce standing access and correlate identity events with sensitive actions.', ai:'AI can help summarise related signals for an analyst; access removal and account recovery follow approved response rules.', evidence:'Review excessive privileges, detection coverage and the time needed to investigate a test incident.'},
  {id:'ransomware', industry:'manufacturing', title:'Recovery depends on the same compromised network', problem:'Backups exist, but shared credentials and undocumented dependencies can delay restoration during a ransomware incident.', approach:'Separate recovery access, map critical dependencies, review backup protection and exercise a staged restoration with the operations team.', ai:'AI can help search approved runbooks and assemble timelines. Engineers approve containment and validate restored services.', evidence:'Test restoration order, backup integrity and recovery time against agreed operational requirements.'},
  {id:'release', industry:'software-telecommunications', title:'Security findings arrive after a release', problem:'Dependencies, secrets and API permissions change faster than a periodic review can follow.', approach:'Bring threat modelling, code and dependency checks into delivery. Prioritise findings by exposure and add a remediation and retest path.', ai:'AI can assist finding triage and code explanations. Engineers verify fixes and approve release exceptions.', evidence:'Measure finding age, repeated weaknesses and whether critical release checks catch seeded test issues.'},
  {id:'ai-data', industry:'professional-services', title:'An AI assistant retrieves the wrong person’s records', problem:'Search can cross client or team boundaries when document permissions and AI retrieval are disconnected.', approach:'Enforce source permissions at retrieval, isolate confidential workspaces, constrain tools and test malicious prompts and cross-tenant access.', ai:'Ground answers in authorised evidence, filter sensitive outputs and require approval for consequential actions.', evidence:'Evaluate unauthorised retrieval attempts, information leakage and handling of ambiguous or unsupported requests.'},
];
---
<Layout title="Cybersecurity services" description="Soft Task cybersecurity: penetration testing, zero-trust architecture, incident response, cloud security, DevSecOps and STRID crypto investigation.">
  <header class="wrap security-hero">
    <div><a href="/services/">What we do / Cybersecurity</a><h1>Protect the systems<br/>your business runs on.</h1><p>Soft Task brings security engineering, investigation and operational readiness together. Start with the systems, people and information that matter most, then strengthen the paths around them.</p><a class="button primary" href="/contact/?service=cybersecurity">Discuss your security priorities</a></div>
    <div class="security-map" aria-label="Security layers: identity, applications, infrastructure and response">
      <svg viewBox="0 0 360 300" role="img" aria-label="Identity and applications connect through verified access to infrastructure and incident response">
        <path class="security-path" d="M70 60H290V240H70Z M70 60L290 240 M290 60L70 240" fill="none" stroke="currentColor" stroke-width="2"/>
        <g fill="#14382d" stroke="#d3ed9c" stroke-width="2"><circle cx="70" cy="60" r="13"/><circle cx="290" cy="60" r="13"/><circle cx="70" cy="240" r="13"/><circle cx="290" cy="240" r="13"/><rect x="108" y="112" width="144" height="76" rx="6"/></g>
        <g fill="currentColor" text-anchor="middle" font-size="14"><text x="70" y="32">Identity</text><text x="290" y="32">Applications</text><text x="70" y="278">Infrastructure</text><text x="290" y="278">Response</text><text x="180" y="145">Verify access.</text><text x="180" y="168">Review evidence.</text></g>
      </svg><p>Security is a connected discipline.</p>
    </div>
  </header>
  <section class="security-ownership"><div class="wrap"><strong>Cybersecurity services by Soft Task</strong><p>Our team manages cybersecurity engagements directly. <a href="/products/kytheos/">Kytheos Guardian</a> is our separate product in public beta, with its wider portfolio in development.</p></div></section>
  <section class="wrap security-services"><header><h2>From architecture<br/>to response.</h2><p>Choose a service to see the work involved and the deliverables we can scope with your team.</p><a href="mailto:contact@softtask.co">contact@softtask.co</a></header><div>{services.map(([name,headline,body,deliverables])=><details><summary>{name}</summary><div class="service-detail"><h3>{headline}</h3><p>{body}</p><p><strong>Engagement outputs</strong><br/>{deliverables}</p></div></details>)}</div></section>
  <section class="security-problems"><div class="wrap"><header><h2>Recognise the risk.<br/>See the response.</h2><p>Explore how security, technology and human judgement come together around a business problem.</p></header><div class="security-case-list">{cases.map(c=><article id={c.id}><h3>{c.title}</h3><p>{c.problem}</p><dl><div><dt>How Soft Task can help</dt><dd>{c.approach}</dd></div><div><dt>AI and human control</dt><dd>{c.ai}</dd></div><div><dt>How we evaluate progress</dt><dd>{c.evidence}</dd></div></dl><a href={`/industries/${c.industry}/`}>Explore the industry context</a></article>)}</div></div></section>
  <section class="wrap security-strid" id="strid"><div><p>Soft Task crypto investigation & recovery division</p><h2>STRID</h2></div><div><h3>Bring clarity to the transaction trail.</h3><p>We help scope crypto incidents, analyse on-chain transaction paths, organise evidence and assess recovery routes with the authorised parties involved. Cross-chain movements, wallet activity and exchange interactions are reviewed in their case context.</p><p>Recovery options depend on evidence, asset movement, platform cooperation and applicable legal processes. Begin with a brief description; our team will agree a suitable channel for case records.</p><a class="button primary" href="mailto:strid@softtask.co">Email strid@softtask.co</a></div></section>
  <section class="wrap security-engagement"><h2>A clear route from concern to action.</h2><ol><li><h3>Scope & authorise</h3><p>Agree assets, objectives, access permissions and rules of engagement.</p></li><li><h3>Assess & prioritise</h3><p>Connect technical evidence to business impact and accountable owners.</p></li><li><h3>Strengthen & validate</h3><p>Implement the agreed controls, retest findings and document the handover.</p></li></ol><p><a href="/governance/security/">Our security policy</a> · <a href="/services/ai-automation/responsible-ai/">Responsible AI engineering</a></p></section>
  <CapabilityConnections id="cybersecurity"/>
</Layout>
<style>
.security-hero{display:grid;grid-template-columns:1.25fr 1fr;gap:64px;align-items:center;padding-block:72px}.security-hero h1{font-size:clamp(38px,4.6vw,68px);line-height:1.14;margin:26px 0}.security-hero p{max-width:58ch;line-height:1.85}.security-hero .button{margin-top:28px}.security-map{background:var(--forest);color:var(--lime);padding:32px}.security-map svg{width:100%;height:auto}.security-map p{text-align:center;margin-top:12px;font-size:14px}.security-ownership{background:#e5eddf;padding-block:28px}.security-ownership .wrap{display:grid;grid-template-columns:1fr 2fr;gap:32px}.security-ownership a,.security-services a,.security-case-list a,.security-engagement a{text-decoration:underline;text-underline-offset:4px}.security-services{display:grid;grid-template-columns:.8fr 1.4fr;gap:72px;padding-block:80px}.security-services h2,.security-problems h2,.security-engagement h2{font-size:clamp(30px,3vw,44px);line-height:1.25;margin-bottom:22px}.security-services header p{margin-bottom:22px}.security-services details{border-top:1px solid #9cac9b}.security-services details:last-child{border-bottom:1px solid #9cac9b}.security-services summary{padding:23px 28px 23px 0;cursor:pointer;font-size:19px;font-weight:600;line-height:1.5}.service-detail{padding:0 0 28px}.service-detail h3{font-size:23px;line-height:1.4;margin-bottom:16px}.service-detail p{line-height:1.85}.security-problems{background:#e5eddf;padding-block:64px}.security-problems header{max-width:650px;margin-bottom:42px}.security-case-list{display:grid;grid-template-columns:1fr 1fr;gap:50px}.security-case-list article{border-top:3px solid var(--forest);padding-top:24px;scroll-margin-top:120px}.security-case-list h3{font-size:26px;line-height:1.35;margin-bottom:18px}.security-case-list dl{margin:24px 0}.security-case-list dl div{margin-top:20px}.security-case-list dt{font-weight:700;margin-bottom:8px}.security-case-list dd{margin:0;line-height:1.8}.security-strid{display:grid;grid-template-columns:.8fr 1.4fr;gap:72px;padding-block:80px}.security-strid h2{font-size:clamp(52px,7vw,100px);margin-top:18px}.security-strid h3{font-size:30px;line-height:1.3;margin-bottom:22px}.security-strid .button{margin-top:24px}.security-engagement{padding-block:20px 64px}.security-engagement ol{display:grid;grid-template-columns:repeat(3,1fr);gap:42px;margin:36px 0;padding-left:24px}.security-engagement h3{font-size:22px;line-height:1.4;margin-bottom:14px}
@media(prefers-reduced-motion:no-preference){.security-path{stroke-dasharray:1800;stroke-dashoffset:1800;animation:security-connect 1.7s ease-out forwards}.security-services details[open] .service-detail{animation:security-open .22s ease-out}@keyframes security-connect{to{stroke-dashoffset:0}}@keyframes security-open{from{opacity:.5;transform:translateY(-5px)}to{opacity:1;transform:translateY(0)}}}
@media(max-width:760px){.security-hero,.security-services,.security-strid,.security-ownership .wrap{grid-template-columns:1fr;gap:28px}.security-hero,.security-services,.security-strid{padding-block:42px}.security-map{padding:20px;max-width:460px;width:100%;justify-self:center}.security-case-list,.security-engagement ol{grid-template-columns:1fr;gap:32px}.security-problems{padding-block:40px}.security-hero h1 br{display:none}.security-hero h1{font-size:40px}.security-hero .button{width:100%}}
</style>

