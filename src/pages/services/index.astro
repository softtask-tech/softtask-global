---
import Layout from '../../layouts/Layout.astro';
import catalogue from '../../data/catalogue.json';
import '../../styles/catalogue.css';
const groups=['Build & connect','Intelligence & data','Platforms & operations','Specialist products'];
---
<Layout title="What we do: 15 connected capability pillars" description="Explore Soft Task's 15 capability pillars, organised across software, AI, data, infrastructure, enterprise systems and specialist products.">
<header class="catalogue-hero wrap"><div><span>What we do</span><h1>Different disciplines.<br />One connected outcome.</h1><p>Our 15 capability pillars are organised around the work they make possible. Start with a discipline, or explore your industry's challenges first.</p><a class="button" href="/industries/">Find your industry</a></div><div class="catalogue-illustration"><h2>Start with the requirement.</h2><p>Build the systems.<br />Connect the information.<br />Operate with clear responsibilities.</p><a href="/solutions/">Explore business problems</a></div></header>
<div class="wrap pillar-groups">{groups.map(group=><section class="pillar-group"><header><h2>{group}</h2><p>{group==='Specialist products'?'Focused product teams within the Soft Task portfolio.':'Connected disciplines, selected to fit the requirement.'}</p></header><div>{catalogue.pillars.filter(p=>p.group===group).map(p=><article class="pillar-item"><h3><a href={p.url}>{p.title}</a></h3><p>{p.description}</p><small>{p.categories.slice(0,3).join(' · ')}</small><a href={p.url}>Explore this capability</a></article>)}</div></section>)}</div>
<section class="wrap catalogue-bottom"><h2>Not sure where your requirement fits?</h2><p>Tell us about the process, the people using it and what needs to work better. We can shape the combination of engineering disciplines with you.</p><a class="button" href="/contact/">Discuss your requirement</a></section>
</Layout>
